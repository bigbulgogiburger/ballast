# Finnhub 뉴스 API 키. config.load()에서 os.environ[...] 필수 — 누락 시 KeyError. 무료 60 req/min.
# required: yes
FINNHUB_API_KEY=

# Financial Modeling Prep 밸류에이션 키. 필수 — 누락 시 KeyError. 무료 250 req/day.
# required: yes
FMP_API_KEY=

# DART(전자공시) 키. KR 펀더멘털 수집 필수 — 누락 시 KeyError.
# required: yes
DART_API_KEY=

# 네이버 검색 API client id. KR 뉴스 필수 — 누락 시 KeyError.
# required: yes
NAVER_CLIENT_ID=

# 네이버 검색 API client secret. 필수 — 누락 시 KeyError.
# required: yes
NAVER_CLIENT_SECRET=

# EDGAR 필수 형식 'name email'. 필수 — 누락 시 KeyError.
# required: yes
SEC_USER_AGENT=

# 한국은행 ECOS 보조용(환율). 선택 — None이면 ECB(1차)·yfinance 폴백(§02 config). os.environ.get() 사용.
# required: no
ECOS_API_KEY=

# 선택 — claude -p를 API 키 인증으로 돌릴 때만. claude -p 구독 로그인이면 불필요·종량과금 없음(§15.1). os.environ.get() 사용.
# required: no
ANTHROPIC_API_KEY=

# 수집 실패 알림 (BAL-37). 셋 다 선택 — 미설정이면 알림 없이 조용히 동작.
# ntfy.sh 푸시 토픽 URL. 토픽명은 추측 가능하니 개인 비공개 토픽명을 쓸 것(예: https://ntfy.sh/ballast-<random>).
# required: no
NTFY_URL=

# Telegram 봇 토큰. BOT_TOKEN+CHAT_ID 둘 다 있어야 Telegram 알림 발송. 토큰은 비밀값 — 커밋 금지.
# required: no
TELEGRAM_BOT_TOKEN=

# Telegram 수신 대상 chat id.
# required: no
TELEGRAM_CHAT_ID=
